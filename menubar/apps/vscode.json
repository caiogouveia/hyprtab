{
  "name": "Visual Studio Code",
  "source": "Atalhos padrão do VS Code no Linux: https://code.visualstudio.com/shortcuts/keyboard-shortcuts-linux.pdf",
  "match": ["code", "code-oss", "code-url-handler", "com.microsoft.vscode", "vscodium", "codium"],
  "menus": [
    {"label": "Arquivo", "items": [
      {"label": "Novo Arquivo de Texto", "keys": "Ctrl+N"},
      {"label": "Nova Janela", "keys": "Ctrl+Shift+N"},
      "-",
      {"label": "Abrir Arquivo…", "keys": "Ctrl+O"},
      {"label": "Abrir Pasta…", "keys": "Ctrl+K Ctrl+O"},
      {"label": "Abrir Recente…", "keys": "Ctrl+R"},
      {"label": "Reabrir Editor Fechado", "keys": "Ctrl+Shift+T"},
      "-",
      {"label": "Salvar", "keys": "Ctrl+S"},
      {"label": "Salvar Como…", "keys": "Ctrl+Shift+S"},
      {"label": "Salvar sem Formatar", "keys": "Ctrl+K S"},
      "-",
      {"label": "Preferências", "items": [
        {"label": "Configurações", "keys": "Ctrl+,"},
        {"label": "Atalhos de Teclado", "keys": "Ctrl+K Ctrl+S"},
        {"label": "Tema de Cores", "keys": "Ctrl+K Ctrl+T"}
      ]},
      "-",
      {"label": "Fechar Editor", "keys": "Ctrl+W"},
      {"label": "Fechar Todos os Editores", "keys": "Ctrl+K Ctrl+W"},
      {"label": "Fechar Pasta", "keys": "Ctrl+K F"},
      {"label": "Fechar Janela", "keys": "Ctrl+Shift+W"}
    ]},
    {"label": "Editar", "items": [
      {"label": "Desfazer", "keys": "Ctrl+Z"},
      {"label": "Refazer", "keys": "Ctrl+Y"},
      "-",
      {"label": "Recortar", "keys": "Ctrl+X"},
      {"label": "Copiar", "keys": "Ctrl+C"},
      {"label": "Colar", "keys": "Ctrl+V"},
      "-",
      {"label": "Localizar", "keys": "Ctrl+F"},
      {"label": "Substituir", "keys": "Ctrl+H"},
      "-",
      {"label": "Localizar nos Arquivos", "keys": "Ctrl+Shift+F"},
      {"label": "Substituir nos Arquivos", "keys": "Ctrl+Shift+H"},
      "-",
      {"label": "Alternar Comentário de Linha", "keys": "Ctrl+/", "send": "Ctrl+code:61"},
      {"label": "Alternar Comentário de Bloco", "keys": "Ctrl+Shift+A"},
      "-",
      {"label": "Formatar Documento", "keys": "Ctrl+Shift+I"}
    ]},
    {"label": "Seleção", "items": [
      {"label": "Selecionar Tudo", "keys": "Ctrl+A"},
      {"label": "Expandir Seleção", "keys": "Shift+Alt+Right"},
      {"label": "Reduzir Seleção", "keys": "Shift+Alt+Left"},
      "-",
      {"label": "Copiar Linha Acima", "keys": "Ctrl+Shift+Alt+Up"},
      {"label": "Copiar Linha Abaixo", "keys": "Ctrl+Shift+Alt+Down"},
      {"label": "Mover Linha Acima", "keys": "Alt+Up"},
      {"label": "Mover Linha Abaixo", "keys": "Alt+Down"},
      {"label": "Excluir Linha", "keys": "Ctrl+Shift+K"},
      "-",
      {"label": "Adicionar Cursor Acima", "keys": "Shift+Alt+Up"},
      {"label": "Adicionar Cursor Abaixo", "keys": "Shift+Alt+Down"},
      {"label": "Adicionar Próxima Ocorrência", "keys": "Ctrl+D"},
      {"label": "Selecionar Todas as Ocorrências", "keys": "Ctrl+Shift+L"}
    ]},
    {"label": "Exibir", "items": [
      {"label": "Paleta de Comandos…", "keys": "Ctrl+Shift+P"},
      "-",
      {"label": "Explorador", "keys": "Ctrl+Shift+E"},
      {"label": "Pesquisa", "keys": "Ctrl+Shift+F"},
      {"label": "Controle do Código-Fonte", "keys": "Ctrl+Shift+G"},
      {"label": "Executar e Depurar", "keys": "Ctrl+Shift+D"},
      {"label": "Extensões", "keys": "Ctrl+Shift+X"},
      "-",
      {"label": "Problemas", "keys": "Ctrl+Shift+M"},
      {"label": "Saída", "keys": "Ctrl+K Ctrl+H"},
      {"label": "Terminal", "keys": "Ctrl+`", "send": "Ctrl+code:49"},
      "-",
      {"label": "Barra Lateral", "keys": "Ctrl+B"},
      {"label": "Painel", "keys": "Ctrl+J"},
      {"label": "Modo Zen", "keys": "Ctrl+K Z"},
      "-",
      {"label": "Ampliar", "keys": "Ctrl+="},
      {"label": "Reduzir", "keys": "Ctrl+-"},
      "-",
      {"label": "Quebra de Linha", "keys": "Alt+Z"}
    ]},
    {"label": "Ir", "items": [
      {"label": "Voltar", "keys": "Ctrl+Alt+-"},
      {"label": "Avançar", "keys": "Ctrl+Shift+-"},
      "-",
      {"label": "Ir para Arquivo…", "keys": "Ctrl+P"},
      {"label": "Ir para Símbolo no Workspace…", "keys": "Ctrl+T"},
      {"label": "Ir para Símbolo no Editor…", "keys": "Ctrl+Shift+O"},
      {"label": "Ir para Linha…", "keys": "Ctrl+G"},
      "-",
      {"label": "Ir para Definição", "keys": "F12"},
      {"label": "Ir para Referências", "keys": "Shift+F12"},
      "-",
      {"label": "Próximo Problema", "keys": "F8"},
      {"label": "Problema Anterior", "keys": "Shift+F8"}
    ]},
    {"label": "Executar", "items": [
      {"label": "Iniciar Depuração", "keys": "F5"},
      {"label": "Executar sem Depurar", "keys": "Ctrl+F5"},
      {"label": "Parar Depuração", "keys": "Shift+F5"},
      {"label": "Reiniciar Depuração", "keys": "Ctrl+Shift+F5"},
      "-",
      {"label": "Depuração: Passar por Cima", "keys": "F10"},
      {"label": "Depuração: Entrar", "keys": "F11"},
      {"label": "Depuração: Sair", "keys": "Shift+F11"},
      "-",
      {"label": "Alternar Ponto de Interrupção", "keys": "F9"}
    ]},
    {"label": "Terminal", "items": [
      {"label": "Novo Terminal", "keys": "Ctrl+Shift+`", "send": "Ctrl+Shift+code:49"},
      {"label": "Dividir Terminal", "keys": "Ctrl+Shift+5"},
      "-",
      {"label": "Executar Tarefa de Build…", "keys": "Ctrl+Shift+B"}
    ]},
    {"label": "Ajuda", "items": [
      {"label": "Mostrar Todos os Comandos", "keys": "Ctrl+Shift+P"},
      {"label": "Referência de Atalhos de Teclado", "keys": "Ctrl+K Ctrl+R"}
    ]}
  ]
}
